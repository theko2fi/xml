- name: Installer et configurer nginx
  gather_facts: false
  hosts: nginxweb
  vars:
    formation_name: "Ansible Advanced"
  tasks:
    - name: Installer nginx
      ansible.builtin.apt:
        name: nginx
        state: present

    - name: Enable service nginx
      ansible.builtin.service:
        name: nginx 
        enabled: yes
        state: started
    
